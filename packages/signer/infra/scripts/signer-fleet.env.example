#!/usr/bin/env bash
# shellcheck shell=bash

# Copy this file to packages/signer/infra/scripts/signer-fleet.env and fill in real values.

CLOUDFLARE_API_TOKEN="replace-me"
CLOUDFLARE_ZONE_NAME="luminadex.com"

SIGNER_IMAGE_REF="ghcr.io/lumina-dex/lumina-signer:latest"

ZEKO_TESTNET_HOSTNAME="zeko-testnet.signer.luminadex.com"
ZEKO_TESTNET_SERVER_IP="replace-me"
ZEKO_TESTNET_SSH_ALIAS="lumina_signer_zeko_testnet"
ZEKO_TESTNET_RUNTIME_ENV_FILE="packages/signer/infra/secrets/zeko-testnet-signer.env"
ZEKO_TESTNET_CI_KEY_FILE="${HOME}/.ssh/lumina_ci_zeko_testnet.pub"

MINA_MAINNET_HOSTNAME="mina-mainnet.signer.luminadex.com"
MINA_MAINNET_SERVER_IP="replace-me"
MINA_MAINNET_SSH_ALIAS="lumina_signer_mina_mainnet"
MINA_MAINNET_RUNTIME_ENV_FILE="packages/signer/infra/secrets/mina-mainnet-signer.env"
MINA_MAINNET_CI_KEY_FILE="${HOME}/.ssh/lumina_ci_mina_mainnet.pub"

ZEKO_MAINNET_HOSTNAME="zeko-mainnet.signer.luminadex.com"
ZEKO_MAINNET_SERVER_IP="replace-me"
ZEKO_MAINNET_SSH_ALIAS="lumina_signer_zeko_mainnet"
ZEKO_MAINNET_RUNTIME_ENV_FILE="packages/signer/infra/secrets/zeko-mainnet-signer.env"
ZEKO_MAINNET_CI_KEY_FILE="${HOME}/.ssh/lumina_ci_zeko_mainnet.pub"
