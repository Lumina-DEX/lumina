#!/usr/bin/env bash
# shellcheck shell=bash

# Copy this file to packages/signer/infra/scripts/signer-fleet.env and fill in real values.

# The scripts refuse to touch the legacy signer host or its known aliases.
LEGACY_SIGNER_HOST="replace-me"
LEGACY_SIGNER_IP="replace-me"

CLOUDFLARE_API_TOKEN="replace-me"
CLOUDFLARE_ZONE_NAME="luminadex.com"

SIGNER_IMAGE_REF="ghcr.io/lumina-dex/lumina-signer@sha256:replace-me"

ZEKO_TESTNET_HOSTNAME="zeko-testnet.signer.luminadex.com"
ZEKO_TESTNET_SERVER_IP="203.0.113.10"
ZEKO_TESTNET_SSH_ALIAS="lumina_signer_zeko_testnet"

MINA_MAINNET_HOSTNAME="mina-mainnet.signer.luminadex.com"
MINA_MAINNET_SERVER_IP="203.0.113.20"
MINA_MAINNET_SSH_ALIAS="lumina_signer_mina_mainnet"

ZEKO_MAINNET_HOSTNAME="zeko-mainnet.signer.luminadex.com"
ZEKO_MAINNET_SERVER_IP="203.0.113.30"
ZEKO_MAINNET_SSH_ALIAS="lumina_signer_zeko_mainnet"
